# ─────────────────────────────────────────────────────────────────────────────
# MODELO DE VARIÁVEIS DE AMBIENTE — copie para `.env` e preencha.
#
# `.env` e `.env.*` estão no .gitignore: NUNCA comite valor de verdade.
# Aqui não há segredo nenhum — só o nome de cada variável, o que ela faz e o
# que acontece quando ela falta.
#
# No Replit, estas variáveis vivem em Secrets (as sensíveis) e em
# `[userenv.shared]` do .replit (as de comportamento, que não são segredo).
# ─────────────────────────────────────────────────────────────────────────────

# ── AS 3 OBRIGATÓRIAS ────────────────────────────────────────────────────────

# Postgres (Neon). Sem ela o servidor LANÇA no import de server/db.ts — não
# sobe pela metade. Use `?sslmode=require` no Neon.
DATABASE_URL=postgres://usuario:senha@host.neon.tech/banco?sslmode=require

# Assina o cookie de sessão. Fail-fast: o servidor se recusa a subir sem ela
# (server/session.ts). Trocá-la DESLOGA todo mundo — é o botão de pânico se
# houver suspeita de vazamento. Gere com: openssl rand -base64 48
SESSION_SECRET=

# Onde os uploads vivem no bucket (Object Storage do Replit), começando com o
# id do bucket: /replit-objstore-<uuid>/.private
PRIVATE_OBJECT_DIR=

# ── AS 6 QUE VALEM EM PRODUÇÃO ───────────────────────────────────────────────

# Caminhos públicos do bucket, separados por vírgula. Sem ela, servir objeto
# público dá erro explicando que falta configurar.
PUBLIC_OBJECT_SEARCH_PATHS=/replit-objstore-<uuid>/public

# Valida o JWT que o portal NORTE manda no SSO. Sem ela o app CAI DE VOLTA para
# o SESSION_SECRET e avisa no log — funciona, mas dois sistemas passam a
# compartilhar o mesmo segredo. Defina um próprio.
SSO_SECRET=

# Porta do servidor. No Replit é 5000 (a única não bloqueada). Padrão: 5000.
PORT=5000

# "production" liga HSTS, X-Frame-Options: DENY e frame-ancestors 'none', e
# serve o build estático em vez do Vite. Qualquer outro valor é desenvolvimento.
NODE_ENV=production

# Digest diário da Revisão Final por e-mail. Só roda quando vale "true".
REVISAO_DIGEST_ENABLED=false

# Digest de acompanhamento da Gestão de Prazos (três envios por dia).
# Só roda quando vale "true".
GESTAO_DIGEST_ENABLED=false

# ── AVISO DE BOOK POR E-MAIL (opcionais; o módulo fica quieto sem elas) ──────

BOOK_EMAIL_NOTIFICATIONS_ENABLED=false
# "true" monta a mensagem e só registra no log, sem enviar. Bom para conferir
# o texto antes de ligar de verdade.
BOOK_EMAIL_DRY_RUN=true
BOOK_EMAIL_FROM=sistema@exemplo.com
BOOK_EMAIL_TO=destinatario@exemplo.com
# Base dos links dentro do e-mail (sem barra no fim).
BOOK_EMAIL_APP_URL=https://exemplo.replit.app

# ── INTEGRAÇÃO COM O CHECKLIST DE ARENA (opcional; é segredo → Secrets) ─────

# Token que o app Checklist de Arena manda em `Authorization: Bearer <token>`
# para LER as peças da Arena entregues (/api/integracao/checklist/*, só GET).
# Ausente ou com menos de 32 caracteres, a integração fica DESLIGADA (503) —
# falha fechada. O mesmo valor vai no Checklist; trocar = trocar nos dois e
# reiniciar. Gere com: openssl rand -base64 48
CHECKLIST_INTEGRACAO_TOKEN=

# ── TEMPO REAL ENTRE CÓPIAS (opcionais) ──────────────────────────────────────

# O LISTEN/NOTIFY do Postgres é o que faz duas cópias do servidor (autoscale)
# enxergarem as mesmas mudanças. Precisa de conexão DIRETA: o pooler do Neon
# não entrega NOTIFY. Sem ela, cai na DATABASE_URL.
TEMPO_REAL_DATABASE_URL=

# "off" desliga o canal e o app volta a ser local a cada cópia — use só para
# isolar um problema.
TEMPO_REAL_CANAL=

# ── PRIMEIRO ACESSO (só num banco NOVO) ──────────────────────────────────────

# Cria as contas iniciais, e SÓ quando a tabela `users` está vazia. Todas
# nascem com "trocar senha no primeiro acesso". Apague a variável depois de
# usar — ela não tem função nenhuma com o banco já povoado.
SEED_PASSWORD=

# ── TESTES ───────────────────────────────────────────────────────────────────
#
# Os testes de servidor (`npm test`) NÃO precisam de nada: o banco é de
# mentira. Quem lê daqui é a suíte de ponta a ponta (e2e/), e o alvo dela
# nunca pode ser produção — ver e2e/README.md.

# Endereço do app de TESTE. Sem esta variável, toda a suíte E2E é pulada.
E2E_BASE_URL=http://localhost:5000

# A mesma senha para os cinco usuários de teste.
E2E_SENHA=

# Um usuário por perfil no banco de teste. Nenhum deles pode estar com troca de
# senha pendente — o login para no /change-password e o teste falha.
E2E_EMAIL_ADMIN=
E2E_EMAIL_SOLICITACAO=
E2E_EMAIL_ARTE=
E2E_EMAIL_GRAFICA=
E2E_EMAIL_ATENDIMENTO=

# ── SCRIPTS DE MANUTENÇÃO (só quando for rodar aquele script) ────────────────

# Lida por scripts/corrigir-senha-placeholder.mjs e checar-senhas-seed.mjs,
# para achar contas que ainda estão com uma senha conhecida.
SENHA_ANTIGA=
