# Preparação inicial: somente homologação, sem dados de produção.
COMPOSE_PROJECT_NAME=grafica-homolog
POSTGRES_DB=grafica_homolog
GRAFICA_DB_USER=grafica_app

# Gerar valores distintos com: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
GRAFICA_DB_PASSWORD=

# Referências de implantação. Ainda não consumidas pelo compose do banco.
GRAFICA_DOMAIN=grafica.appsnorte.com
GRAFICA_BACKUP_DIR=./backups

# E-mails ficam desligados ao preparar a aplicação de homologação.
REVISAO_DIGEST_ENABLED=false
GESTAO_DIGEST_ENABLED=false
BOOK_EMAIL_NOTIFICATIONS_ENABLED=false
BOOK_EMAIL_DRY_RUN=true
